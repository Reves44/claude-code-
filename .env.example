# ── Server ──────────────────────────────────────────────
PORT=3000

# ── Email (Gmail SMTP) ───────────────────────────────────
# Create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
BUSINESS_EMAIL=your-gmail@gmail.com   # where booking alerts go

# ── SMS via Twilio (optional) ────────────────────────────
# Sign up free at twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+18655551234       # your Twilio number
BUSINESS_PHONE=+18656925335           # where SMS alerts go

# ── Stripe ───────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
DEPOSIT_AMOUNT=2500                   # $25.00 in cents

# ── Site URL (used for Stripe redirect) ──────────────────
BASE_URL=http://localhost:3000
